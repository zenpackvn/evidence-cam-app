# https://dart.dev/guides/libraries/private-files

# -------------------------------------------------------------------------
# Flutter/Dart
# -------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
# `build/` chỉ khớp THƯ MỤC. Trên máy dùng ổ ngoài exFAT, `build` là một
# symlink trỏ sang ổ APFS (exFAT sinh file `._*` phá Gradle), và symlink thì
# luật trên không bắt — nên nó lọt vào `git status` và chờ ai đó `git add .`
# rồi commit một đường dẫn chỉ đúng trên đúng một máy.
build

# -------------------------------------------------------------------------
# build_runner-generated Dart code. Regenerated on demand
# (`dart run build_runner build --delete-conflicting-outputs`); CI and the
# release lanes generate it before building. See README "Code Generation".
# -------------------------------------------------------------------------
*.g.dart
*.freezed.dart
*.config.dart
*.gen.dart
# ObjectBox is the deliberate exception: its generated binding stays tracked
# alongside packages/database/lib/objectbox-model.json (which no glob matches).
# Together they encode stable entity/schema UIDs that must persist across builds
# for on-device DB migrations. The binding lives in the database package now that
# entities are centralized there, so it is un-ignored at that path.
!packages/database/lib/objectbox.g.dart

# Test coverage output
coverage/

# Ảnh chẩn đoán khi một golden TRƯỢT (testImage/maskedDiff/isolatedDiff).
#
# Mẫu cũ là `test/**/golden/failures/` — đòi một thư mục `golden/` mà đường dẫn
# thật không hề có (`test/capture/failures/`, `test/design/failures/`). Nó khớp
# KHÔNG tệp nào, nên trông như đã vá mà chẳng bỏ qua gì: 360 ảnh vẫn nằm trong
# git và mỗi lượt chạy test lại làm bẩn cây làm việc.
#
# Ảnh chuẩn trong `goldens/` thì GIỮ — đó mới là thứ test so vào.
test/**/failures/

