# -------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -------------------------------------------------------------------------
# FVM (Flutter Version Manager)
# -------------------------------------------------------------------------
.fvm/

# -------------------------------------------------------------------------
# AI / editor tooling (machine-local; kept here rather than relying on a
# user-global ~/.config/git/ignore so the rules travel with the repo)
# -------------------------------------------------------------------------
.claude/settings.local.json
.claude/scheduled_tasks.lock
.cursor/

# -------------------------------------------------------------------------
# MCP
# -------------------------------------------------------------------------
.mcp/**/node_modules/

# Local helper binaries / UI inspection artifacts
.bin/
.fvm_bin/
screen.png
window_dump.xml

# -------------------------------------------------------------------------
# Fastlane (ios/fastlane). The .env holds App Store Connect credentials and
# the App Store Connect API .p8 key must never be committed. Build output and
# fastlane's run reports are machine-local. Gemfile.lock is intentionally
# committed (not ignored) so gem versions are reproducible.
# -------------------------------------------------------------------------
**/fastlane/.env
**/fastlane/.env.*
!**/fastlane/.env.example
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/test_output/
ios/fastlane/build/
# MỌI khóa .p8, không chỉ AuthKey_*. App Store Connect API key, In-App Purchase
# key và Subscription key đều là .p8 với tiền tố khác nhau — rule hẹp theo tên
# từng loại đã để lọt SubscriptionKey_*.p8 vào git status một lần rồi.
**/*.p8

# Service account JSON của Google Play (fastlane supply + tool/play_subs.mjs).
# Đây là khoá RIÊNG, ngang .p8 của Apple: ai cầm được nó thì đọc/ghi được sản
# phẩm, giá và doanh thu của app trên Play.
#
# Rule đặt theo THƯ MỤC chứ không theo tên file, vì tên do Google sinh
# (`<project>-<hash>.json`) nên không đoán trước được — và .gitignore của repo
# này không có luật `*.json` nào chặn giúp. Cần thêm một file JSON KHÔNG bí mật
# vào fastlane thì phải `!` nó ra một cách tường minh.
**/fastlane/*.json

# -------------------------------------------------------------------------
# NGOẠI LỆ: android/fastlane/ được theo dõi ĐẦY ĐỦ (chủ repo chốt 2026-08-11).
#
# ⚠️ Thư mục này chứa BÍ MẬT THẬT, và từ đây chúng nằm trong lịch sử git:
#   · play-service-account.json  — khoá riêng, đọc/ghi sản phẩm + giá + doanh
#     thu trên Google Play của com.aktechvn.zenpack
#   · client_secret_*.json       — OAuth client secret (Google Drive BYOS của
#     backend; client_id đã ở wrangler.toml, secret đã ở Worker secret)
#
# Hệ quả cần biết trước, không phải sau: ai clone được repo là cầm được cả hai.
# Gỡ ra sau này KHÔNG đủ — phải rewrite history VÀ xoay lại cả hai khoá, vì bản
# cũ vẫn nằm trong mọi clone đã phát ra.
#
# Ngoại lệ này CHỈ cho android/. `ios/fastlane/` giữ nguyên luật chặn: nó chứa
# .env của App Store Connect và khoá .p8, chưa ai quyết định mở.
# -------------------------------------------------------------------------
!android/fastlane/.env
!android/fastlane/*.json

# Đường CI GHI KHOÁ PLAY SỐNG RA, và nó nằm NGOÀI thư mục fastlane nên ngoại lệ
# ở trên không phủ tới — `release.yml` đổ `secrets.PLAY_STORE_JSON_KEY` vào đây
# rồi trỏ `PLAY_STORE_JSON_KEY_PATH` vào nó. Trên CI thì cây bị vứt đi sau mỗi
# lượt chạy nên không sao; nguy là lúc ai đó chạy lane ấy trên MÁY MÌNH rồi
# `git add -A`. Khác hẳn ngoại lệ phía trên: đó là một quyết định đã cân nhắc,
# còn đây chỉ là một đường chưa ai rào.
android/play-store-key.json

# -------------------------------------------------------------------------
# Firebase
# -------------------------------------------------------------------------
firebase.json
.firebaserc
# lib/firebase_options.dart is intentionally committed as a non-real PLACEHOLDER
# so the template builds out of the box; run `flutterfire configure` to generate
# your own (it overwrites the placeholder locally). Native config stays ignored.
# ios/Runner/GoogleService-Info.plist
# macos/Runner/GoogleService-Info.plist

# -------------------------------------------------------------------------
# Local screenshot/demo tooling (not part of the template surface)
# -------------------------------------------------------------------------
tool/seed_demo.sh
tool/capture_sim_window.sh

# -------------------------------------------------------------------------
# Rác AppleDouble của macOS
# -------------------------------------------------------------------------
# Ổ này không phải APFS/HFS+, nên macOS ghi resource fork ra file `._<tên>`
# riêng bên cạnh MỌI file bị đụng tới. Chúng không chỉ bẩn `git status`: một
# `._native_assets.json` lạc vào `build/` từng làm `flutter test` crash hẳn
# ("PathNotFoundException: Deletion failed"), và trong `.git/objects/pack/`
# chúng khiến git kêu "non-monotonic index" ở mọi lệnh.
._*

# Báo cáo sự cố của flutter tool — sinh ra lúc chạy, không phải nguồn.
flutter_*.log

# Artefact bản phát hành giữ lại ngoài build/ (build/ bị dọn mỗi lần build lại).
dist/
.calm/
