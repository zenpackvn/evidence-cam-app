# Fastfile — iOS build + TestFlight upload for the flavored Flutter app.
#
# This is a template/scaffold: every account-specific value is read from the
# environment (see fastlane/.env.example), so the repo carries no secrets and
# no project-specific identifiers. Fill in fastlane/.env, then run:
#
#   bundle exec fastlane beta flavor:prod
#
# Authentication uses an App Store Connect API key (.p8). Code signing uses
# `match`: the distribution certificate and provisioning profiles live in a
# private git repo (MATCH_GIT_URL) and are fetched here, so every machine and
# CI runner signs identically. Run `bundle exec fastlane match appstore` once
# locally to create the assets before the first release.

# Map a Flutter flavor to its Xcode scheme, build configuration, and the
# bundle-id suffix this template applies per flavor (prod uses the base id).
FLAVORS = {
  "dev"     => { scheme: "dev",     configuration: "Release-dev",     suffix: ".dev" },
  "staging" => { scheme: "staging", configuration: "Release-staging", suffix: ".staging" },
  "prod"    => { scheme: "prod",    configuration: "Release-prod",     suffix: "" },
}.freeze

# Fail early with a clear message when a required value is missing, instead of
# letting an action fail later with an opaque error.
def require_env(name)
  value = ENV[name]
  if value.nil? || value.strip.empty?
    UI.user_error!(
      "Missing required environment variable: #{name}. " \
      "Copy fastlane/.env.example to fastlane/.env and fill it in."
    )
  end
  value
end

# Resolve the build number (CFBundleVersion). TestFlight rejects a duplicate or
# non-increasing value, so prefer an explicit, monotonic source: the lane arg,
# then BUILD_NUMBER (CI sets this), then the git commit count as a fallback.
# In CI use BUILD_NUMBER — a shallow checkout makes the commit count unreliable.
def resolve_build_number(options)
  explicit = options[:build_number] || ENV["BUILD_NUMBER"]
  return explicit.to_s unless explicit.nil? || explicit.to_s.strip.empty?
  sh("git", "rev-list", "--count", "HEAD").strip
end

# Run the Flutter SDK from the repo root. The command is overridable via
# FLUTTER_CMD so CI (which puts `flutter` on PATH directly) can set
# FLUTTER_CMD=flutter; locally it defaults to the FVM-pinned SDK.
def flutter(*args)
  cmd = ENV.fetch("FLUTTER_CMD", "fvm flutter").split
  Dir.chdir("..") do # fastlane runs in ios/; the Flutter project root is one up.
    # Strip fastlane's bundler env (BUNDLE_*/GEM_HOME) so Flutter's own
    # `pod install` runs against the ambient Homebrew CocoaPods instead of
    # colliding with the rbenv Ruby that `bundle exec fastlane` runs under
    # ("CocoaPods installed but broken"). No-op in CI where FLUTTER_CMD=flutter
    # and the runner already isolates the env.
    Bundler.with_unbundled_env { sh(*cmd, *args) }
  end
end

default_platform(:ios)

platform :ios do
  desc "Build a flavor and upload it to TestFlight."
  desc "Usage: bundle exec fastlane beta flavor:prod (flavor: dev|staging|prod)"
  lane :beta do |options|
    flavor = (options[:flavor] || "prod").to_s
    config = FLAVORS.fetch(flavor) do
      UI.user_error!(
        "Unknown flavor '#{flavor}'. Expected one of: #{FLAVORS.keys.join(', ')}."
      )
    end

    # On CI, create a temporary keychain for match to import the cert into.
    setup_ci if is_ci?

    bundle_id = "#{require_env('IOS_BUNDLE_ID_BASE')}#{config[:suffix]}"
    build_number = resolve_build_number(options)

    api_key = app_store_connect_api_key(
      key_id: require_env("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: require_env("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: require_env("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    # Automatic signing: xcodebuild fetches/creates the App Store distribution
    # cert + provisioning profile for this bundle id using the ASC API key set
    # above (via -allowProvisioningUpdates below). No match repo needed — same
    # approach as the sibling `omaniha` project, signing with team
    # APPLE_TEAM_ID.

    # Compile Dart + assets without signing; gym handles archive & signing using
    # the match-provisioned profile selected below. The dart-define file carries
    # the flavor's runtime config (API URL, FLAVOR, etc.) read via
    # String.fromEnvironment — without it the build ships default/empty config.
    # --obfuscate renames Dart symbols in the release binary; --split-debug-info
    # writes the symbol map so obfuscated crash stacks can be reversed later
    # (keep build/symbols/ as a CI artifact and feed it to
    # `flutter symbolize`). Without the symbols, obfuscated crashes are
    # unreadable.
    flutter(
      "build", "ios", "--release", "--no-codesign",
      "--flavor", flavor, "--build-number", build_number,
      "--dart-define-from-file", "env/#{flavor}.json",
      "--obfuscate", "--split-debug-info=build/symbols/#{flavor}"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: config[:scheme],
      configuration: config[:configuration],
      export_method: "app-store",
      output_directory: "build/ipa",
      output_name: "#{flavor}.ipa",
      xcargs: "-allowProvisioningUpdates " \
              "CODE_SIGN_STYLE=Automatic " \
              "DEVELOPMENT_TEAM=#{require_env('APPLE_TEAM_ID')}",
      export_options: {
        signingStyle: "automatic",
        teamID: require_env("APPLE_TEAM_ID"),
        uploadBitcode: false,
        uploadSymbols: true,
      },
    )

    # Upload dSYMs so release crashes symbolicate in Firebase Crashlytics. Skip
    # gracefully when the Firebase config or symbols are absent (e.g. a local
    # build without GoogleService-Info.plist in place).
    dsym_path = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    gsp_path = "Runner/GoogleService-Info.plist"
    if dsym_path && File.exist?(gsp_path)
      upload_symbols_to_crashlytics(
        dsym_path: dsym_path,
        gsp_path: gsp_path,
        binary_path: ENV.fetch(
          "CRASHLYTICS_UPLOAD_SYMBOLS_BIN",
          "Pods/FirebaseCrashlytics/upload-symbols",
        ),
      )
    end

    # Internal testers get every processed build automatically. External
    # distribution is opt-in (external:true, or FL_DISTRIBUTE_EXTERNAL=true from
    # tool/deploy-testflight.sh) and additionally submits the build to the named
    # App Store Connect external groups — which needs the build fully processed
    # and passing Apple's Beta App Review, so we must wait for processing.
    distribute_external = options[:external] == true ||
                          ENV["FL_DISTRIBUTE_EXTERNAL"] == "true"
    external_groups = (ENV["TESTFLIGHT_GROUPS"] || "")
                      .split(",").map(&:strip).reject(&:empty?)
    if distribute_external && external_groups.empty?
      UI.user_error!(
        "External distribution needs TESTFLIGHT_GROUPS — a comma-separated " \
        "list of App Store Connect external tester group names (e.g. \"Beta\")."
      )
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      distribute_external: distribute_external,
      groups: distribute_external ? external_groups : nil,
      notify_external_testers: distribute_external,
      changelog: distribute_external ? changelog_from_git_commits(commits_count: 10) : nil,
      # App-level "Test Information" Apple requires before external review. Set in
      # .env, or fill once in App Store Connect (it then persists).
      beta_app_description: distribute_external ? ENV["TESTFLIGHT_BETA_DESCRIPTION"] : nil,
      beta_app_feedback_email: distribute_external ? ENV["TESTFLIGHT_FEEDBACK_EMAIL"] : nil,
      # Internal-only delivery needn't block on Apple's processing; external
      # submission does (the build must finish processing before review).
      skip_waiting_for_build_processing: !distribute_external,
    )
  end

  desc "Distribute an ALREADY-uploaded build to external testers — no rebuild."
  desc "Usage: bundle exec fastlane distribute version:1.7.0 build:480"
  lane :distribute do |options|
    setup_ci if is_ci?
    api_key = app_store_connect_api_key(
      key_id: require_env("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: require_env("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: require_env("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true,
    )
    groups = (ENV["TESTFLIGHT_GROUPS"] || "")
             .split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("Set TESTFLIGHT_GROUPS in .env") if groups.empty?
    upload_to_testflight(
      api_key: api_key,
      app_identifier: require_env("IOS_BUNDLE_ID_BASE"),
      # No ipa here (distribute-only), so the platform + export-compliance answer
      # must be explicit — otherwise pilot prompts and crashes non-interactively.
      app_platform: "ios",
      uses_non_exempt_encryption: false,
      distribute_only: true,
      app_version: options[:version],
      build_number: options[:build]&.to_s,
      distribute_external: true,
      groups: groups,
      notify_external_testers: true,
      beta_app_description: ENV["TESTFLIGHT_BETA_DESCRIPTION"],
      beta_app_feedback_email: ENV["TESTFLIGHT_FEEDBACK_EMAIL"],
      # "What to Test" (per-build notes) — external submission requires it.
      changelog: ENV["TESTFLIGHT_WHATS_NEW"] ||
                 "Bản thử nghiệm EvidenceCam. Vui lòng thử luồng quay video " \
                 "bằng chứng đóng hàng và gửi phản hồi.",
    )
  end

  desc "Build a flavor's IPA (ad-hoc signed) and distribute it via Firebase App Distribution."
  desc "Usage: bundle exec fastlane firebase flavor:dev (flavor: dev|staging|prod)"
  lane :firebase do |options|
    flavor = (options[:flavor] || "dev").to_s
    config = FLAVORS.fetch(flavor) do
      UI.user_error!(
        "Unknown flavor '#{flavor}'. Expected one of: #{FLAVORS.keys.join(', ')}."
      )
    end

    setup_ci if is_ci?

    bundle_id = "#{require_env('IOS_BUNDLE_ID_BASE')}#{config[:suffix]}"
    build_number = resolve_build_number(options)

    api_key = app_store_connect_api_key(
      key_id: require_env("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: require_env("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: require_env("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    # Ad-hoc profiles are separate from the App Store ones the `beta`/`release`
    # lanes use — Firebase App Distribution installs directly on registered
    # test devices, which an App Store-method archive can't do. Run
    # `bundle exec fastlane match adhoc` once locally to create these before
    # the first use of this lane.
    match(
      type: "adhoc",
      app_identifier: bundle_id,
      api_key: api_key,
      readonly: is_ci?,
    )

    flutter(
      "build", "ios", "--release", "--no-codesign",
      "--flavor", flavor, "--build-number", build_number,
      "--dart-define-from-file", "env/#{flavor}.json",
      "--obfuscate", "--split-debug-info=build/symbols/#{flavor}"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: config[:scheme],
      configuration: config[:configuration],
      export_method: "ad-hoc",
      output_directory: "build/ipa",
      output_name: "#{flavor}-adhoc.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_id => "match AdHoc #{bundle_id}",
        },
      },
    )

    firebase_app_distribution(
      app: require_env("FIREBASE_IOS_APP_ID_#{flavor.upcase}"),
      ipa_path: lane_context[SharedValues::IPA_OUTPUT_PATH],
      groups: ENV["FIREBASE_DISTRIBUTION_GROUPS"] || "internal-testers",
      release_notes: options[:release_notes] || changelog_from_git_commits(commits_count: 5),
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
    )
  end
end
