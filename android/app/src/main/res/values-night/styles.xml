<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CỐ Ý dùng theme SÁNG kể cả khi máy bật Dark Mode.

         Giao diện Flutter của ZenPack chỉ có một bảng màu sáng, không có bản
         tối. Để cửa sổ Android theo chế độ tối thì lệch ở hai chỗ thấy được:
         một nháy đen lúc khởi động trước khi Flutter vẽ khung đầu tiên, và —
         nặng hơn — WebView khai với trang web rằng đang ở chế độ tối.

         Chỗ thứ hai là lý do thật: màn cấp quyền Google Drive nhúng trang của
         Google, và trang đó đọc `prefers-color-scheme` từ theme này. Để tối
         thì người dùng thấy một tấm đen sì trồi lên giữa một app trắng, không
         còn giống bảng chọn tài khoản của hệ điều hành nữa.

         Đổi lại đây là chỗ đúng: webview_flutter không phơi ra
         `setAlgorithmicDarkeningAllowed`, nên theme của cửa sổ là cần gạt duy
         nhất. Ngày nào ZenPack có giao diện tối thật thì trả file này về
         Theme.Black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
