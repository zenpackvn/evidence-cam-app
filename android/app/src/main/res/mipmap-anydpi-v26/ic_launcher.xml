<?xml version="1.0" encoding="utf-8"?>
<!--
  Inset 20%, không phải 6%.

  Android chỉ bảo đảm phần GIỮA của lớp trước hiện ra: khung 108dp nhưng vùng
  an toàn chỉ là hình tròn 66dp ở giữa (~61%), phần ngoài bị mặt nạ của từng
  hãng cắt đi — Samsung cắt theo hình vuông bo, Pixel cắt theo hình tròn. Inset
  6% để hình vẽ chiếm tới 88% khung, tức tràn hẳn ra ngoài vùng an toàn, và
  trên máy thật thì mũi tên vòng cung lẫn thùng hàng đều bị xén cụt bốn phía.

  20% đưa hình về đúng ~60% khung — vừa khít vùng an toàn, nên icon hiện đủ
  trên mọi mặt nạ.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="20%" />
  </foreground>
</adaptive-icon>
